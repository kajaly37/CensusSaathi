# ===================================================
# CensusSaathi GenAI Backend Environment Configuration
# ===================================================
# Server-side OpenAI API Key (Never expose this in browser or client code!)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (defaults to gpt-4o-mini if not specified)
# Supported options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o-mini
